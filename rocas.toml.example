# rocas - Roblox Open Cloud Asset Sync
# Copy this file to rocas.toml and edit it to match your project.

[creator]
type = "user"       # "user" or "group"
id = 123456789      # Your Roblox User ID or Group ID

# Each [[sync]] section defines an asset group to sync.
# Assets are uploaded via the Roblox Open Cloud API.
# The asset type is auto-detected from file extensions: .rbxm / .rbxmx sync as
# Model, so animation exports need assetType = "Animation" on their group.
# Mesh formats (.fbx .glb .gltf .obj) are the exception: Roblox converts those
# into a Model on upload and never gives the original file back, so `rocas fetch`
# cannot restore them. They are skipped unless the group says assetType = "Model".
# output generates a strict .luau file by default.

[[sync]]
name = "images"
path = "assets/images"
output = "src/shared/images"

[[sync]]
name = "sounds"
path = "assets/sounds"
output = "src/shared/sounds"

[[sync]]
name = "meshes"
path = "assets/meshes"
output = "src/shared/meshes"
assetType = "Model"   # required for .fbx / .glb / .gltf / .obj

[[sync]]
name = "animations"
path = "assets/animations"
output = "src/shared/animations"
assetType = "Animation"   # .rbxm defaults to Model

[[sync]]
name = "videos"
path = "assets/videos"
output = "src/shared/videos"

# --- Options ---
# format: "luau" (default) generates .luau only with --!strict and type annotations
#         "roblox-ts" generates a .luau + .d.ts pair for roblox-ts projects
# stripExtensions: true removes file extensions from keys
#   e.g. images.ui.button instead of images.ui["button.png"]
# resolveImageIds: true (default) resolves the decal id Open Cloud returns for an
#   image into the image id inside it, so ImageLabel.Image works. Needs an API key
#   with read access to Assets. Set it to false to always emit the decal id.

# Example: roblox-ts project
# [[sync]]
# name = "images"
# path = "assets/images"
# output = "src/shared/images"
# format = "roblox-ts"
# stripExtensions = false

# You can also force a specific asset type for a group:
# [[sync]]
# name = "custom-anims"
# path = "assets/fbx-animations"
# output = "src/shared/custom-anims"
# assetType = "Animation"
